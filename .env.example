# This file is read only by Docker Compose for variable substitution in docker-compose.yml.
# docker-compose.yml passes OPENAI_API_KEY and OPENAI_MODEL to the backend.
# The backend itself does not load .env; it reads environment variables only.

# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# OpenAI model used for translation (optional, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# NOTE: The variables below are NOT passed to the backend by docker-compose.yml,
# so setting them in .env has no effect with any startup method. They take effect
# only when exported as shell environment variables before running the backend
# directly on the host (e.g. `cd backend && go run .`).

# OpenAI TTS model (optional, default: gpt-4o-mini-tts)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# OpenAI TTS voice (optional, default: marin)
# OPENAI_TTS_VOICE=marin

# OpenAI transcription model used by /api/interpret when no transcript is sent (optional, default: gpt-4o-transcribe)
# WHISPER_MODEL=gpt-4o-transcribe

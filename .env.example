# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# OpenAI model used for translation (optional, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# NOTE: OPENAI_TTS_MODEL, OPENAI_TTS_VOICE and WHISPER_MODEL below are NOT passed
# to the backend by docker-compose.yml. When started with Docker Compose, these
# values are ignored and the backend defaults are used.

# OpenAI TTS model (optional, default: gpt-4o-mini-tts)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# OpenAI TTS voice (optional, default: marin)
OPENAI_TTS_VOICE=marin

# OpenAI transcription model used by /api/interpret when no transcript is sent (optional, default: gpt-4o-transcribe)
WHISPER_MODEL=gpt-4o-transcribe
